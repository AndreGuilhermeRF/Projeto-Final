# Neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ALTERE_PARA_SUA_SENHA
NEO4J_DATABASE=neo4j

# Dataset
CHATBULARIO_LIMIT=0

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
VECTOR_DIMENSIONS=768

# Modo rápido: extração por léxico e regras
ENABLE_MODEL_NER=true
ENABLE_LLM_EXTRACTION=true

# Extração completa: habilite os dois acima para usar NER e Ollama
NER_MODEL=BrazilAI/openmed-br-clinical-pt
NER_THRESHOLD=0.40
NER_CPU_THREADS=2

OLLAMA_RE_CHUNK_CHARS=1800
OLLAMA_RE_MAX_CHUNKS=5
OLLAMA_RE_TIMEOUT=120
OLLAMA_RE_NUM_PREDICT=350

# Desempenho
EMBED_BATCH_SIZE=64
# Algoritmos de grafo (PageRank, Louvain, Leiden, Shortest Path)
# auto = usa Neo4j GDS se instalado; gds = exige GDS; python = força o fallback em Python
GRAPH_ANALYTICS_ENGINE=auto

